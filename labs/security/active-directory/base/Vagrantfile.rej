@@ -354,6 +457,71 @@ end
 # 5-Method adapter detection with DAD disabled and SkipAsSource=false
 # ------------------------------------------------------------
 def configure_windows_static_ip(vm, ip)
+  # Adapter naming and the provider's NAT range differ between providers:
+  # libvirt commonly surfaces the lab NIC as "Ethernet 1" with the default
+  # NAT network on 192.168.121.0/24, while VirtualBox surfaces it as
+  # "Ethernet"/"Ethernet 2" with NAT on 10.0.2.0/24.
+  if PROVIDER == :libvirt
+    adapter_detect_ps = <<-PS
+          # Method 3: Look for adapter named "Ethernet 1" (most common for libvirt)
+          $adapter = Get-NetAdapter -Name "Ethernet 1" -ErrorAction SilentlyContinue
+
+          if ($adapter) {
+            Write-Host "[OK] Found adapter by name: Ethernet 1"
+          } else {
+            # Method 4: Look for any adapter that's NOT the NAT one (exclude 192.168.121.x)
+            $natIp = Get-NetIPAddress -IPAddress 192.168.121.* -ErrorAction SilentlyContinue |
+                     Select-Object -First 1
+            if ($natIp) {
+              $natAdapter = Get-NetAdapter -InterfaceIndex $natIp.InterfaceIndex -ErrorAction SilentlyContinue
+              Write-Host "[INFO] NAT adapter: $($natAdapter.Name) (192.168.121.x)"
+
+              # Get all adapters except the NAT one
+              $allAdapters = Get-NetAdapter -ErrorAction SilentlyContinue |
+                             Where-Object { $_.Status -eq 'Up' -and $_.Name -notlike "*Loopback*" }
+              $adapter = $allAdapters | Where-Object { $_.Name -ne $natAdapter.Name } | Select-Object -First 1
+
+              if ($adapter) {
+                Write-Host "[OK] Found non-NAT adapter: $($adapter.Name)"
+              }
+            }
+          }
+    PS
+  else
+    adapter_detect_ps = <<-PS
+          # Method 3: Look for adapter named "Ethernet 2" (common for VirtualBox)
+          $adapter = Get-NetAdapter -Name "Ethernet 2" -ErrorAction SilentlyContinue
+
+          if ($adapter) {
+            Write-Host "[OK] Found adapter by name: Ethernet 2"
+          } else {
+            # Method 4: Look for adapter named "Ethernet" (VirtualBox default)
+            $adapter = Get-NetAdapter -Name "Ethernet" -ErrorAction SilentlyContinue
+
+            if ($adapter) {
+              Write-Host "[OK] Found adapter by name: Ethernet"
+            } else {
+              # Method 5: Look for any non-NAT adapter (exclude 10.0.2.x)
+              $natIp = Get-NetIPAddress -IPAddress 10.0.2.* -ErrorAction SilentlyContinue |
+                       Select-Object -First 1
+              if ($natIp) {
+                $natAdapter = Get-NetAdapter -InterfaceIndex $natIp.InterfaceIndex -ErrorAction SilentlyContinue
+                Write-Host "[INFO] NAT adapter: $($natAdapter.Name) (10.0.2.x)"
+
+                # Get all adapters except the NAT one
+                $allAdapters = Get-NetAdapter -ErrorAction SilentlyContinue |
+                               Where-Object { $_.Status -eq 'Up' -and $_.Name -notlike "*Loopback*" }
+                $adapter = $allAdapters | Where-Object { $_.Name -ne $natAdapter.Name } | Select-Object -First 1
+
+                if ($adapter) {
+                  Write-Host "[OK] Found non-NAT adapter: $($adapter.Name)"
+                }
+              }
+            }
+          }
+    PS
+  end
+
   vm.vm.provision "shell",
     name: "fixed-static-ip",
     privileged: true,

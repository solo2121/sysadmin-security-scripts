@@ -549,6 +695,26 @@ end
 # SAFE INTERNET ISOLATION FUNCTION - WORKING VERSION FROM 1.2
 # ------------------------------------------------------------
 def disable_internet_gateway(vm, vm_name)
+  # The NAT adapter's name/IP range differs between providers: libvirt
+  # exposes it via a virtio NIC on 192.168.121.0/24, VirtualBox names it
+  # "NAT"/"VirtualBox Host-Only" on 10.0.2.0/24.
+  if PROVIDER == :libvirt
+    nat_match_ps = <<-PS.strip
+          $_.Name -like "*eth0*" -or
+          $_.InterfaceDescription -like "*virtio*" -or
+          (Get-NetIPAddress -InterfaceIndex $_.ifIndex -ErrorAction SilentlyContinue |
+           Where-Object { $_.IPAddress -like "192.168.121.*" })
+    PS
+  else
+    nat_match_ps = <<-PS.strip
+          $_.Name -like "*eth0*" -or
+          $_.Name -like "*NAT*" -or
+          $_.Name -like "*VirtualBox Host-Only*" -or
+          (Get-NetIPAddress -InterfaceIndex $_.ifIndex -ErrorAction SilentlyContinue |
+           Where-Object { $_.IPAddress -like "10.0.2.*" })
+    PS
+  end
+
   vm.vm.provision "shell",
     name: "disable-internet-gateway-#{vm_name}",
     privileged: true,
@@ -563,10 +729,7 @@ def disable_internet_gateway(vm, vm_name)
       
       $natAdapter = Get-NetAdapter | Where-Object { 
         $_.Status -eq 'Up' -and (
-          $_.Name -like "*eth0*" -or 
-          $_.InterfaceDescription -like "*virtio*" -or
-          (Get-NetIPAddress -InterfaceIndex $_.ifIndex -ErrorAction SilentlyContinue | 
-           Where-Object { $_.IPAddress -like "192.168.121.*" })
+          #{nat_match_ps}
         )
       } | Select-Object -First 1
       

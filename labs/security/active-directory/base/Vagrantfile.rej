 # Version: 1.13 - Enterprise Edition (FLAT NETWORK - PROFILE-BASED)
 # Release Date: unreleased
 #
+# UNIFIED VAGRANTFILE: this single file supports both KVM/QEMU via
+# vagrant-libvirt and VirtualBox. Select a provider explicitly, e.g.:
+#   vagrant up --provider=libvirt
+#   vagrant up --provider=virtualbox
+# or set VAGRANT_DEFAULT_PROVIDER. If neither is set, libvirt is used on
+# Linux hosts and VirtualBox elsewhere (see current_provider below).
+# Set LAB_GUI=true to run VirtualBox VMs with a GUI window (headless by
+# default; no effect under libvirt).
+#
 # Changes in v1.13:
 # - Added LAB_PROFILE (minimal/ad/web/cloud/full) to control which
 #   optional VMs are created; "vagrant up" no longer always builds
@@ -45,6 +54,33 @@ rescue => e
   puts "[WARN] config.rb loaded with errors: #{e.message}"
 end
 
+# ------------------------------------------------------------
+# PROVIDER DETECTION (unified libvirt + VirtualBox Vagrantfile)
+# ------------------------------------------------------------
+# Checks, in Vagrant's own precedence order: CLI --provider flag,
+# then VAGRANT_DEFAULT_PROVIDER, then a host-OS-based default
+# (libvirt on Linux, VirtualBox elsewhere).
+def current_provider
+  ARGV.each_with_index do |arg, idx|
+    if arg == '--provider' && ARGV[idx + 1]
+      return ARGV[idx + 1].to_sym
+    elsif arg =~ /\A--provider=(.+)\z/
+      return Regexp.last_match(1).to_sym
+    end
+  end
+
+  return ENV['VAGRANT_DEFAULT_PROVIDER'].to_sym if ENV['VAGRANT_DEFAULT_PROVIDER']
+
+  RbConfig::CONFIG['host_os'] =~ /linux/ ? :libvirt : :virtualbox
+end
+
+PROVIDER = current_provider
+puts "Provider: #{PROVIDER}"
+
+# Set LAB_GUI=true to open a VirtualBox GUI window per VM (default: headless).
+# No effect under libvirt.
+LAB_GUI = ENV.fetch('LAB_GUI', 'false').downcase == 'true'
+
 # ------------------------------------------------------------
 # DOMAIN CONSTANTS
 # ------------------------------------------------------------
